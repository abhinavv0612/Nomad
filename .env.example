# Environment variables for the Go backend.
#
# ⚠️  THIS FILE IS A REFERENCE, NOT A CONFIG FILE.
#
# The backend uses only the Go standard library and has no dotenv loader, so
# copying this to `.env` does nothing — the file is never read. Export the
# variables in your shell instead:
#
#     export GOOGLE_PLACES_API_KEY=AIza...
#     go run .
#
# or set them for a single run:
#
#     GOOGLE_PLACES_API_KEY=AIza... PORT=8090 go run .


# ---- GOOGLE_PLACES_API_KEY (optional) ----
# Enables the live Google Places layer. Get one from a Google Cloud project
# with "Places API (New)" enabled and billing active — the legacy "Places API"
# will not work, since the client calls places.googleapis.com/v1.
#
# Unset, the server still starts and everything else works; the two
# /api/google/* routes return 503. Look for "Google Places live-fetch
# enabled" in the startup log to confirm the key was picked up.
GOOGLE_PLACES_API_KEY=your_key_here

# ---- PORT (optional) ----
# Port to listen on. Defaults to 8080. Set this if something else already
# holds 8080 locally; hosting platforms inject it automatically.
PORT=8080
